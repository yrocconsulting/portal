# Copy to .env.local for local development (`npx supabase status` prints the local values).
# In Vercel, set these under Project > Settings > Environment Variables.

# Supabase project URL and publishable key (Supabase dashboard > Project Settings > API Keys).
# Both are safe in the browser: row level security decides what each user can see.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of the portal, used for sign in redirects. Leave empty locally.
NEXT_PUBLIC_SITE_URL=

# ---- Email intake (helpdesk mailbox via Microsoft Graph). Server only: never NEXT_PUBLIC_. ----
# Supabase secret key (Project Settings > API Keys > Secret keys). Used only by the email intake jobs.
SUPABASE_SECRET_KEY=
# Entra app "Yroc Portal Mail" (application permissions Mail.ReadWrite + Mail.Send, limited to the two mailboxes).
MS_TENANT_ID=
MS_MAIL_CLIENT_ID=
MS_MAIL_CLIENT_SECRET=
HELPDESK_MAILBOX=helpdesk@yrocconsulting.com
NOREPLY_MAILBOX=no-reply@yrocconsulting.com
# Any long random string. Vercel Cron sends it; it also signs Microsoft's new-mail notifications.
CRON_SECRET=

# ---- Client logins ----
# Long random value (40+ characters) used to encrypt client passwords. Keep a copy in a safe place:
# if it is lost or changed, saved passwords can no longer be read.
CREDENTIALS_KEY=

# ---- AI visibility (weekly ProRankTracker results from the website repo) ----
# Same long random value as the PORTAL_INGEST_SECRET GitHub secret in yrocconsulting/staging.
PRT_INGEST_SECRET=

# ---- Google Search Console (read-only service account) ----
# The service account's JSON key file contents (or the same, base64 encoded). Add the service account's
# email as a Restricted user on each client's Search Console property.
GSC_SERVICE_ACCOUNT=
