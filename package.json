{
  "name": "portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,realtime",
    "db:reset": "supabase db reset",
    "test:e2e": "node tests/e2e.cjs",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e:email": "node tests/e2e-email.cjs",
    "test:e2e:clients": "node tests/e2e-clients.cjs",
    "test:e2e:visibility": "node tests/e2e-visibility.cjs",
    "test:e2e:profiles": "node tests/e2e-profiles.cjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "exceljs": "^4.4.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
